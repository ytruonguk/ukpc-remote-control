# Copy to .env.vps on the VPS. DNS A → box, then:
#   ./scripts/vps-up.sh && sudo ./scripts/vps-nginx.sh

RC_DOMAIN=rc.example.com

POSTGRES_USER=rc
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rc

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN_SEC=28800
AGENT_JWT_EXPIRES_SEC=60

MQTT_PASSWORD=
EMQX_DASHBOARD_PASSWORD=change-me

HMDM_BASE_URL=
HMDM_USERNAME=
HMDM_PASSWORD=
HMDM_AGENT_PACKAGE=com.you.rcagent
HMDM_WAKE_ACTION=com.you.rcagent.WAKE

# Host loopback ports (container ports stay 3000/3001/80/1883)
HOST_API_PORT=3000
HOST_RELAY_PORT=3001
HOST_WEB_PORT=8080
HOST_MQTT_PORT=1883

# Agent: mqtts://RC_DOMAIN:8883  username=clientId=deviceId
# Console: https://RC_DOMAIN     admin / admin123 (seed)
