FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json* ./
COPY packages/shared/package.json packages/shared/
COPY apps/rc-api/package.json apps/rc-api/
COPY apps/rc-relay/package.json apps/rc-relay/
COPY apps/rc-ingest/package.json apps/rc-ingest/
COPY apps/rc-web/package.json apps/rc-web/
RUN npm install
COPY . .
RUN npm run build -w @rc/shared && npm run build -w @rc/web

FROM nginx:1.27-alpine
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/rc-web/dist /usr/share/nginx/html
EXPOSE 80
