NODE_ENV=development

# --- Postgres ---
POSTGRES_USER=rc
POSTGRES_PASSWORD=rc
POSTGRES_DB=rc
DATABASE_URL=postgres://rc:rc@localhost:5432/rc

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- MQTT / EMQX ---
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=ingest
MQTT_PASSWORD=

# --- JWT ---
JWT_SECRET=change-me-in-production
AGENT_JWT_EXPIRES_SEC=60

# --- Relay ---
RELAY_NODE=local
RELAY_PUBLIC_HOST=localhost:3001
RELAY_WS_SCHEME=ws
RELAY_BIND=0.0.0.0
RELAY_PORT=3001

# --- HTTP ---
API_PORT=3000
INGEST_PORT=3002
WEB_PORT=5173
CORS_ORIGIN=http://localhost:5173

# --- Headwind MDM ---
HMDM_BASE_URL=http://localhost:8080
HMDM_USERNAME=
HMDM_PASSWORD=
HMDM_AGENT_PACKAGE=com.you.rcagent
HMDM_WAKE_ACTION=com.you.rcagent.WAKE

# Seed login (docker/postgres/02-seed.sql)
# username: admin
# password: admin123
